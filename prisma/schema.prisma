generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Rôle DANS un club précis (pas un rôle global) ────────────────────────
enum ClubRole {
  ADHERENT
  TUTEUR
  COACH
  BUREAU
  TRESORIER
  SECRETAIRE
  ADMIN
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  firstName             String
  lastName              String
  phone                 String?
  isSuperAdmin          Boolean   @default(false) // toi/Karim : accès technique à TOUS les clubs
  isActive              Boolean   @default(true)
  refreshToken          String?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Un compte peut appartenir à plusieurs clubs, avec un rôle différent dans chacun
  memberships           ClubMembership[]

  adherentsAsTuteur     Adherent[] @relation("TuteurAdherents")
  adherentProfile       Adherent[] @relation("CompteAdherent")

  @@map("users")
}

// ── Le club lui-même ───────────────────────────────────────────────────
model Club {
  id            String   @id @default(uuid())
  nom           String
  ville         String?
  logoUrl       String?
  description   String?
  federation    String?  // ex: "FFLDA"
  inviteCode    String   @unique // code court partagé pour rejoindre le club, ex: "ETOILE-2K7X"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   ClubMembership[]
  adherents     Adherent[]

  @@map("clubs")
}

// ── Le lien User ↔ Club, avec le rôle propre à CE club ────────────────────
model ClubMembership {
  id         String   @id @default(uuid())
  role       ClubRole @default(ADHERENT)
  dateDebut  DateTime @default(now())
  dateFin    DateTime?

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // Un même compte ne peut avoir qu'UNE seule appartenance active par club
  @@unique([userId, clubId])
  @@map("club_memberships")
}

model Adherent {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  birthDate     DateTime
  isMinor       Boolean  @default(false)
  licenceFFLDA  String?
  ageCategory   String?
  weightKg      Float?
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Chaque fiche adhérent appartient à un club précis
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // Compte utilisateur associé (adhérent majeur uniquement)
  userId        String?
  user          User?    @relation("CompteAdherent", fields: [userId], references: [id])

  // Tuteur responsable (adhérent mineur uniquement)
  tuteurId      String?
  tuteur        User?    @relation("TuteurAdherents", fields: [tuteurId], references: [id])

  documents     Document[]
  cotisations   Cotisation[]

  // La licence FFLDA doit être unique DANS un club, pas globalement
  // (deux clubs différents pourraient théoriquement avoir un souci de numérotation externe)
  @@unique([licenceFFLDA, clubId])
  @@map("adherents")
}

model Document {
  id            String   @id @default(uuid())
  type          String
  fileUrl       String
  status        String   @default("PENDING")
  extractedData Json?
  createdAt     DateTime @default(now())

  adherentId    String
  adherent      Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Cotisation {
  id            String    @id @default(uuid())
  saison        String    // ex: "2025-2026"
  montant       Float
  statut        String    @default("IMPAYE") // IMPAYE | PAYE | PARTIEL
  datePaiement  DateTime?
  moyenPaiement String?   // ex: "Espèces", "Virement", "Chèque"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  adherentId    String
  adherent      Adherent  @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  // Une seule cotisation par adhérent et par saison
  @@unique([adherentId, saison])
  @@map("cotisations")
}
