generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Rôle DANS un club précis (pas un rôle global) ────────────────────────
enum ClubRole {
  ADHERENT
  TUTEUR
  COACH
  BUREAU
  TRESORIER
  SECRETAIRE
  ADMIN
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  firstName             String
  lastName              String
  phone                 String?
  isSuperAdmin          Boolean   @default(false) // toi/Karim : accès technique à TOUS les clubs
  isActive              Boolean   @default(true)
  refreshToken          String?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Un compte peut appartenir à plusieurs clubs, avec un rôle différent dans chacun
  memberships           ClubMembership[]

  adherentsAsTuteur     Adherent[] @relation("TuteurAdherents")
  adherentProfile       Adherent[] @relation("CompteAdherent")
  groupesEncadres       EntraineurGroupe[]
  vehiculesConduits VehiculeCovoiturage[]
  @@map("users")
}

// ── Le club lui-même ───────────────────────────────────────────────────
model Club {
  id            String   @id @default(uuid())
  nom           String
  ville         String?
  logoUrl       String?
  description   String?
  federation    String?  // ex: "FFLDA"
  inviteCode    String   @unique // code court partagé pour rejoindre le club, ex: "ETOILE-2K7X"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   ClubMembership[]
  adherents     Adherent[]
  tarifs        TarifCotisation[]
  codesPromo    CodePromo[]
  groupes       Groupe[]
  deplacements  Deplacement[]
  @@map("clubs")
}

// ── Le lien User ↔ Club, avec le rôle propre à CE club ────────────────────
model ClubMembership {
  id         String   @id @default(uuid())
  role       ClubRole @default(ADHERENT)
  dateDebut  DateTime @default(now())
  dateFin    DateTime?

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // Un même compte ne peut avoir qu'UNE seule appartenance active par club
  @@unique([userId, clubId])
  @@map("club_memberships")
}

model Adherent {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  birthDate     DateTime
  isMinor       Boolean  @default(false)
  licenceFFLDA  String?
  ageCategory   String?
  weightKg      Float?
  status        String   @default("DRAFT")

  // ── Identité complémentaire (7.2 cahier des charges) ──────────────────
  sexe          String?
  lieuNaissance String?
  nationalite   String?

  // ── Type d'adhésion (7.1) ──────────────────────────────────────────────
  typeAdhesion  String?

  // ── Sportif ─────────────────────────────────────────────────────────
  niveau        String?
  stylePratique String?

  // ── Santé ───────────────────────────────────────────────────────────
  allergies           String?
  questionnaireSante  String?
  certificatMedicalOk Boolean @default(false)

  // ── Administratif ───────────────────────────────────────────────────
  ancienneLicence String?
  clubPrecedent   String?

  // ── Coordonnées de l'adhérent (ou de son tuteur si mineur) ───────────────
  email         String?
  telephone     String?
  adresse       String?
  codePostal    String?
  ville         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clubId        String
  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?    @relation("CompteAdherent", fields: [userId], references: [id])

  tuteurId      String?
  tuteur        User?    @relation("TuteurAdherents", fields: [tuteurId], references: [id])

  documents     Document[]
  cotisations   Cotisation[]
  groupes       MembreGroupe[]
  presences     Presence[]
  deplacements  ParticipantDeplacement[]
  covoiturages  PassagerVehicule[]
  @@unique([licenceFFLDA, clubId])
  @@map("adherents")
}

model Document {
  id            String   @id @default(uuid())
  type          String
  fileUrl       String
  status        String   @default("PENDING")
  extractedData Json?
  createdAt     DateTime @default(now())

  adherentId    String
  adherent      Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Cotisation {
  id            String    @id @default(uuid())
  saison        String    // ex: "2025-2026"
  montant       Float     // montant final, après application du tarif + réductions
  montantBase   Float?    // montant avant réduction (pour traçabilité/affichage)
  montantVerse  Float?    // ce qui a réellement été payé (utile si statut = PARTIEL)
  statut        String    @default("IMPAYE") // IMPAYE | PAYE | PARTIEL
  echeance      DateTime? // date limite de paiement (si paiement en une fois)
  datePaiement  DateTime?
  moyenPaiement String?   // ESPECES | CHEQUE | VIREMENT | PASS_SPORT | COUPON | STRIPE | PAYPAL
  prestataire   String?   // ex: "Stripe", "PayPal" — si paiement en ligne
  recuUrl       String?   // lien vers le reçu/justificatif généré
  codePromoUtilise String? // le code promo appliqué, s'il y en a un
  paiementEnPlusieursFois Boolean @default(false) // si vrai, voir les EcheancePaiement liées
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  adherentId    String
  adherent      Adherent  @relation(fields: [adherentId], references: [id], onDelete: Cascade)
  echeances     EcheancePaiement[]

  // Une seule cotisation par adhérent et par saison
  @@unique([adherentId, saison])
  @@map("cotisations")
}

// ── Une échéance individuelle, quand le paiement est fractionné (PAY-003) ──
model EcheancePaiement {
  id            String    @id @default(uuid())
  numero        Int       // 1, 2, 3... l'ordre de l'échéance
  montant       Float
  dateEcheance  DateTime  // date limite de CETTE échéance précise
  statut        String    @default("IMPAYE") // IMPAYE | PAYE
  datePaiement  DateTime?
  moyenPaiement String?
  createdAt     DateTime  @default(now())

  cotisationId  String
  cotisation    Cotisation @relation(fields: [cotisationId], references: [id], onDelete: Cascade)

  @@unique([cotisationId, numero])
  @@map("echeances_paiement")
}

model TarifCotisation {
  id          String   @id @default(uuid())
  saison      String   // ex: "2025-2026"
  categorie   String?  // ex: "Poussins", "Cadets"... null = tarif par défaut (toutes catégories sans tarif spécifique)
  montant     Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // Un seul tarif par catégorie et par saison, dans un club donné
  @@unique([clubId, saison, categorie])
  @@map("tarifs_cotisation")
}

model CodePromo {
  id             String    @id @default(uuid())
  code           String    // ex: "FAMILLE2026"
  typeReduction  String    @default("POURCENTAGE") // POURCENTAGE | MONTANT
  valeur         Float     // ex: 10 (= 10% si POURCENTAGE, ou 10€ si MONTANT)
  actif          Boolean   @default(true)
  dateExpiration DateTime?
  createdAt      DateTime  @default(now())

  clubId         String
  club           Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // Le même code ne peut pas être créé deux fois dans le même club
  @@unique([clubId, code])
  @@map("codes_promo")
}

// ═══════════════════════ GROUPES & PRÉSENCES (MEM-002, MEM-003) ═══════════

model Groupe {
  id            String    @id @default(uuid())
  nom           String    // ex: "Compétiteurs Cadets"
  categorie     String?   // catégorie d'âge concernée
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clubId        String
  club          Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  membres       MembreGroupe[]
  entraineurs   EntraineurGroupe[]
  creneaux      Creneau[]
  seances       Seance[]

  @@map("groupes")
}

// ── Un adhérent peut appartenir à plusieurs groupes ──────────────────────
model MembreGroupe {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  groupeId    String
  groupe      Groupe   @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  adherentId  String
  adherent    Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  @@unique([groupeId, adherentId])
  @@map("membres_groupe")
}

// ── Un ou plusieurs entraîneurs peuvent encadrer un groupe ───────────────
model EntraineurGroupe {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  groupeId    String
  groupe      Groupe   @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupeId, userId])
  @@map("entraineurs_groupe")
}

// ── Créneau récurrent d'un groupe (ex: "Mardi 18h-19h30, Salle A") ───────
model Creneau {
  id          String   @id @default(uuid())
  jour        Int      // 0 = lundi ... 6 = dimanche
  heureDebut  String   // ex: "18:00"
  heureFin    String   // ex: "19:30"
  lieu        String?
  createdAt   DateTime @default(now())

  groupeId    String
  groupe      Groupe   @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@map("creneaux")
}

// ── Une séance réelle, ponctuelle (générée depuis un créneau ou créée manuellement) ──
model Seance {
  id          String     @id @default(uuid())
  date        DateTime
  lieu        String?
  annulee     Boolean    @default(false)
  commentaire String?
  createdAt   DateTime   @default(now())

  groupeId    String
  groupe      Groupe     @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  presences   Presence[]

  @@map("seances")
}

// ── Le statut de présence d'UN adhérent à UNE séance ─────────────────────
model Presence {
  id          String   @id @default(uuid())
  statut      String   @default("NON_RENSEIGNE") // PRESENT | ABSENT | RETARD | EXCUSE | NON_RENSEIGNE
  commentaire String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seanceId    String
  seance      Seance   @relation(fields: [seanceId], references: [id], onDelete: Cascade)

  adherentId  String
  adherent    Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  @@unique([seanceId, adherentId])
  @@map("presences")
}
// ═══════════════════════ DÉPLACEMENTS & COVOITURAGE (TRIP-001 à TRIP-007) ═══

model Deplacement {
  id            String    @id @default(uuid())
  titre         String    // ex: "Tournoi régional — Nancy"
  lieu          String
  dateDepart    DateTime
  dateRetour    DateTime?
  heureRdv      String?   // ex: "07:30"
  lieuRdv       String?
  statut        String    @default("PLANIFIE") // PLANIFIE | VALIDE | ANNULE | TERMINE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clubId        String
  club          Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // Rattachement optionnel à une compétition (module pas encore développé,
  // la relation est prête pour plus tard).
  competitionId String?

  participants  ParticipantDeplacement[]
  vehicules     VehiculeCovoiturage[]

  @@map("deplacements")
}

// ── Un adhérent inscrit à ce déplacement (avant même d'être affecté à un
// véhicule précis) ─────────────────────────────────────────────────────
model ParticipantDeplacement {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())

  deplacementId String
  deplacement   Deplacement @relation(fields: [deplacementId], references: [id], onDelete: Cascade)

  adherentId    String
  adherent      Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  @@unique([deplacementId, adherentId])
  @@map("participants_deplacement")
}

// ── Un véhicule proposé par un conducteur pour ce déplacement ────────────
model VehiculeCovoiturage {
  id            String   @id @default(uuid())
  nbPlaces      Int      // nombre de places passager (hors conducteur)
  pointDepart   String?
  contraintes   String?  // ex: "Pas de mineur seul", "Coffre limité"
  createdAt     DateTime @default(now())

  deplacementId String
  deplacement   Deplacement @relation(fields: [deplacementId], references: [id], onDelete: Cascade)

  conducteurId  String   // userId du conducteur (parent/bénévole/staff)
  conducteur    User     @relation(fields: [conducteurId], references: [id])

  passagers     PassagerVehicule[]

  @@map("vehicules_covoiturage")
}

// ── Un adhérent affecté à un siège précis d'un véhicule ──────────────────
model PassagerVehicule {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())

  vehiculeId    String
  vehicule      VehiculeCovoiturage @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)

  adherentId    String
  adherent      Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  // Autorisation parentale spécifique à CE déplacement — obligatoire si
  // l'adhérent est mineur, vérifiée avant de valider le plan de transport.
  autorisationOk Boolean @default(false)

  @@unique([vehiculeId, adherentId])
  @@map("passagers_vehicule")
}

